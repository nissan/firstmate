diff --git a/bin/fm-runway-lib.sh b/bin/fm-runway-lib.sh
index 33c0b09..6c0bec9 100644
--- a/bin/fm-runway-lib.sh
+++ b/bin/fm-runway-lib.sh
@@ -243,7 +243,7 @@ fm_runway_check() {
   FM_RUNWAY_PROVIDER=$provider
   fm_runway_read_snapshot || return 1
   line=$(printf '%s\n' "$FM_RUNWAY_SNAPSHOT_DATA" |
-    fm_runway_verdict "$provider" "$(fm_quota_scope_model "$harness" "$model")" "$(fm_quota_lane "$harness" "$model")") || line=""
+    fm_runway_verdict "$provider" "$(fm_quota_scope_model "$harness" "$model")" "") || line=""
