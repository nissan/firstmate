# head test + head ci.yml with the sweep step also added to job test-coverage:
  test-coverage:
    name: Test coverage guard
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - name: Prove complete regression partition
        run: bin/fm-test-run.sh --check-coverage
      - name: Duplicate completeness sweep
        timeout-minutes: 15
        run: bin/fm-lint.sh --check-local-exclusions

